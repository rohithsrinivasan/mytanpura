# Copy to keystore.properties (git-ignored) to sign local release builds.
#
# Create the keystore once, and keep it safe - Google Play ties your app's
# identity to it forever:
#
#   keytool -genkeypair -v \
#     -keystore tanpura-release.jks \
#     -alias tanpura \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the project root.

storeFile=tanpura-release.jks
storePassword=CHANGE_ME
keyAlias=tanpura
keyPassword=CHANGE_ME
